# Copy this file to .env and adjust as needed. All values have safe defaults, so the app
# runs with no .env at all.

PORT=3000

# Secret used to sign JWT login tokens. CHANGE THIS to a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# --- Email reminders (optional) ---
# Left blank, reminders are printed to the server console instead of being emailed, so the
# app works with no account. To send real email, install an email library (e.g. SendGrid's
# @sendgrid/mail) and fill in the key, then implement the TODO in src/services/email.js.
SENDGRID_API_KEY=
EMAIL_FROM=no-reply@example-salon.test

# --- Payments (optional) ---
# Left as "mock", booking payments are approved locally without a real charge. To take real
# payments, set PAYMENT_MODE=stripe, add your key, and implement the TODO in
# src/services/payment.js.
PAYMENT_MODE=mock
STRIPE_SECRET_KEY=

# How many hours before an appointment to send the reminder.
REMINDER_HOURS_BEFORE=24
